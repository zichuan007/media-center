# AList 数据目录
ALIST_DATA_DIR=G:/docker-data/alist

# Jellyfin 配置和缓存目录
JELLYFIN_CONFIG_DIR=G:/docker-data/jellyfin/config
JELLYFIN_CACHE_DIR=G:/docker-data/jellyfin/cache

# MoviePilot 配置和媒体目录
MOVIEPILOT_CONFIG_DIR=G:/docker-data/moviepilot/config
MOVIEPILOT_MEDIA_DIR=G:/docker-data/moviepilot/media

# 本地媒体/下载目录（挂载到容器内）
LOCAL_MEDIA_DIR=E:/

# MoviePilot API Token
MOVIEPILOT_API_TOKEN=media-center-token
